FROM debian:bullseye

# Test the actual distro Python/Pillow/GTK versions without changing the host.
RUN printf 'deb http://deb.debian.org/debian bullseye main\n' > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-gi gir1.2-gtk-3.0 python3-pil librsvg2-common \
        xvfb xauth fonts-dejavu-core adwaita-icon-theme \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1

CMD ["/bin/sh", "-c", "python3 --version && python3 -m unittest discover -s tests -v && xvfb-run -a python3 tools/gui_smoke.py"]
